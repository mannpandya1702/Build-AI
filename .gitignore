# secrets: keys live here at runtime, never committed (SETUP.md §5, §13)
.env.local
.env

# deps + build artifacts
node_modules/
demos/
data/cache/
.DS_Store
*.log

# audit screenshots: regenerable binary artifacts of prospect sites, never committed (repo bloat)
data/screenshots/
**/data/screenshots/

# generated demo builds: composed per-lead sites (source + downloaded photos), regenerable
data/builds/
**/data/builds/

# generated demo template artifacts
templates/*/node_modules/
templates/*/.next/
templates/*/out/

# monorepo
**/node_modules/
.turbo/
**/.next/
**/dist/
/tmp-outbox/

# TS incremental build info
*.tsbuildinfo
apps/worker/data/

# PII — prospect data lives only in Postgres (MASTER_SPEC §9); full history purge in Phase 1
data/leads.json
data/research/
legacy/data/cache/
legacy/data/research/
drafts/

# Vercel CLI local link + build state (not committed; recreated on deploy)
.vercel
