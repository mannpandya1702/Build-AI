# Agency Autopilot environment (spec §10). Copy to .env.local and fill. Secrets never commit.
# MOCK_MODE=true must run with only DATABASE_URL + a dummy ANTHROPIC_API_KEY.

# ---------- Core ----------
# Local dev: postgres://autopilot:autopilot_local_dev@localhost:5432/agency_autopilot
# Production: the Supabase connection string (Settings -> Database -> Connection string)
DATABASE_URL=

# Anthropic API (Haiku for extraction/scoring/classification, Sonnet for analysis/build/QA)
ANTHROPIC_API_KEY=

# ---------- Supabase (production; local dev uses plain Postgres above) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Lead discovery + auditing ----------
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=

# ---------- Deploys ----------
VERCEL_TOKEN=
VERCEL_TEAM_ID=
AGENCY_DOMAIN=            # e.g. tradecraftsites.com
DEMO_BASE_DOMAIN=         # e.g. demo.tradecraftsites.com (until then: {slug}-{studio}.vercel.app)

# ---------- Email ----------
RESEND_API_KEY=           # transactional: booking confirms, operator notices, delivery
# JSON array of outreach mailboxes on the SEPARATE outreach domain (spec §7), e.g.
# [{"email":"mann@gettradecraft.com","smtpHost":"smtp.gmail.com","smtpPort":465,"user":"...","pass":"...","warmupUntil":"2026-08-01"}]
OUTREACH_MAILBOXES=
# Gmail API OAuth for reply ingestion (polling every 5 min)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# ---------- Booking ----------
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=

# ---------- Modes + notifications ----------
OUTREACH_MODE=review      # review (default) | auto. Final-delivery emails are ALWAYS review.
MOCK_MODE=true            # true: all adapters mocked, zero external calls, zero spend
TELEGRAM_BOT_TOKEN=       # optional
TELEGRAM_CHAT_ID=         # optional
