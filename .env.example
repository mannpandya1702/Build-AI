# Copy this file to .env.local and fill in the real values.
# Everything here is NEXT_PUBLIC_ because it is embedded in the client bundle —
# do not put secrets in this file.

# The published Google Form used for enquiries.
# Get it from: Google Form → Send → the <> embed tab → copy the src URL.
# Both the /viewform and the ?embedded=true form are accepted; the app
# normalises whichever you paste.
NEXT_PUBLIC_GOOGLE_FORM_EMBED_URL="https://docs.google.com/forms/d/e/REPLACE_WITH_REAL_FORM_ID/viewform"

# Canonical site origin. Used for metadata, OG tags, sitemap.xml and JSON-LD.
# No trailing slash.
NEXT_PUBLIC_SITE_URL="https://riwaaya.in"

# ---------------------------------------------------------------------------
# Studio panel at /admin. NOT NEXT_PUBLIC_ — these stay server-side.
# Without ADMIN_PASSWORD the panel returns 503 rather than opening unprotected.
# ---------------------------------------------------------------------------
ADMIN_USER=riwaaya
ADMIN_PASSWORD=

# Optional — visitor numbers inside the studio panel.
#
# Vercel Analytics is already collecting regardless of anything below, and its
# own charts work with no setup at all. These variables only matter if you want
# the figures shown inside /admin alongside everything else.
#
# Set ONE of the two pairs. Umami has a free tier; Plausible is paid but its
# API is the simplest. Whichever is filled in is the one that gets used.
UMAMI_SITE_ID=
UMAMI_API_KEY=
# Only for a self-hosted Umami — cloud accounts need nothing here.
# UMAMI_HOST=https://analytics.example.com

PLAUSIBLE_SITE_ID=
PLAUSIBLE_API_KEY=
